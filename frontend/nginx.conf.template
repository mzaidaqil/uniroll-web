server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API calls are forwarded to the Spring Boot container, so the browser only ever
    # talks to this one origin: no CORS needed, in compose or in production
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite puts a content hash in these file names, so they can be cached for a year
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # React Router handles URLs like /teaching/5/edit in the browser. If someone refreshes
    # or opens one directly, nginx has no such file, so it serves index.html and React takes over.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
